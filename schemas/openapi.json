            "type": "string",
            "title": "Message Id"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "message_id"
        ],
        "title": "EngagementStart"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
