          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "message",
          "synthetic"
        ],
        "title": "IntakeInput"
      },
      "Message": {
        "properties": {
          "id": {
            "type": "string",
            "maxLength": 100,
            "minLength": 1,
            "title": "Id"
          },
          "channel": {
            "type": "string",
            "enum": [
              "sms",
              "email",
              "chat"
            ],
            "title": "Channel"
          },
          "text": {
            "type": "string",
            "title": "Text"
          },
          "sender": {
            "type": "string",
            "maxLength": 100,
            "minLength": 1,
            "title": "Sender"
          },
          "timestamp": {
            "type": "string",
            "title": "Timestamp"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "id",
          "channel",
          "text",
          "sender",
          "timestamp"
        ],
        "title": "Message"
      },
      "ScanRequest": {
        "properties": {
          "text": {
            "type": "string",
            "title": "Text"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "text"
        ],
        "title": "ScanRequest"
      },
      "SessionInput": {
        "properties": {
          "session_id": {
            "type": "string",
            "title": "Session Id"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "session_id"
        ],
        "title": "SessionInput"
      },
      "TextInput": {
        "properties": {
          "text": {
            "type": "string",
            "title": "Text"
          },
          "synthetic": {
            "type": "boolean",
            "title": "Synthetic"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "text",
          "synthetic"
        ],
        "title": "TextInput"
      },
      "TrainingInput": {
        "properties": {
          "text": {
            "type": "string",
            "title": "Text"
          },
          "synthetic": {
            "type": "boolean",
            "title": "Synthetic"
          },
          "session_id": {
            "type": "string",
            "title": "Session Id"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "text",
          "synthetic",
          "session_id"
        ],
        "title": "TrainingInput"
      },
      "TrainingStart": {
        "properties": {
          "dna_id": {
            "type": "string",
            "title": "Dna Id"
          },
          "consent": {
            "type": "boolean",
            "title": "Consent"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "dna_id",
          "consent"
        ],
        "title": "TrainingStart"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
